{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitepack.org/schemas/enrichment-report.schema.json",
  "title": "SitePack Enrichment Report",
  "type": "object",
  "required": ["sourcePackageId", "resultPackageId", "startedAt", "finishedAt", "assets"],
  "properties": {
    "sourcePackageId": { "type": "string", "minLength": 1 },
    "resultPackageId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["embedded", "unavailable", "changed", "unsupported"] },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "warning": { "type": "string", "maxLength": 2048 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
