{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitepack.org/schemas/mapping-recipe.schema.json",
  "title": "SitePack Mapping Recipe",
  "type": "object",
  "required": ["spec", "id", "version", "author", "source", "target", "rules"],
  "properties": {
    "spec": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "sitepack-mapping-recipe" },
        "version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "version": { "$ref": "#/$defs/semver" },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "source": { "$ref": "#/$defs/profileConstraint" },
    "target": { "$ref": "#/$defs/profileConstraint" },
    "requires": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+(?:/[a-z0-9._-]+)?$" }
        },
        "transforms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationKind" }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "lossPolicy": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lossLevel" }
        },
        "failOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lossLevel" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "profileConstraint": {
      "type": "object",
      "required": ["profile", "version"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "operationKind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "lossLevel": { "enum": ["none", "representational", "content", "behavioral", "security"] },
    "endpoint": {
      "type": "object",
      "required": ["entity"],
      "properties": {
        "entity": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "relation": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "asset": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "kind", "from"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "kind": { "$ref": "#/$defs/operationKind" },
        "required": { "type": "boolean", "default": true },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "converter": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "params": {
          "type": "object",
          "properties": {
            "type": { "enum": ["boolean", "integer", "number", "string", "object", "array"] },
            "value": { "type": ["string", "number", "integer", "boolean", "null"] },
            "values": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
            },
            "sectionTitle": { "type": "string", "maxLength": 255 },
            "format": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
            "preserveOriginalType": { "type": "boolean" },
            "preserveOriginalUrl": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "loss": { "$ref": "#/$defs/lossLevel" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "value.drop" } }, "required": ["kind"] },
          "then": {},
          "else": { "required": ["to"] }
        },
        {
          "if": { "properties": { "kind": { "const": "content.convert" } }, "required": ["kind"] },
          "then": { "required": ["converter"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
