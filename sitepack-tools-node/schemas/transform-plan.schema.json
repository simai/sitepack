{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitepack.org/schemas/transform-plan.schema.json",
  "title": "SitePack Transform Plan",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "recipe": { "$ref": "#/$defs/ref" },
    "source": { "$ref": "#/$defs/ref" },
    "target": { "$ref": "#/$defs/ref" },
    "inputsDigest": { "$ref": "#/$defs/digest" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "expectedOutputs": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "lossPolicy": {
      "type": "object",
      "properties": {
        "allowed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lossLevel" } },
        "failOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lossLevel" } }
      },
      "additionalProperties": false
    },
    "digest": { "$ref": "#/$defs/digest" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": true },
          "from": { "type": "object", "additionalProperties": true },
          "to": { "type": "object", "additionalProperties": true },
          "converter": { "type": "string" },
          "loss": { "$ref": "#/$defs/lossLevel" },
          "params": {}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "lossLevel": { "enum": ["none", "representational", "content", "behavioral", "security"] },
    "ref": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
