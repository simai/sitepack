{
  "name": "sitepack/sitepack-tools-php",
  "description": "CLI validator and semantic compatibility planner for SitePack packages",
  "type": "project",
  "license": "MIT",
  "version": "1.2.0",
  "require": {
    "php": ">=8.1",
    "ext-sodium": "*",
    "symfony/console": "^6.4",
    "opis/json-schema": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "SitePack\\": "src/"
    }
  },
  "bin": ["bin/sitepack-validate", "bin/sitepack-compatibility"]
}
